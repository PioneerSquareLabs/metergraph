  "unsupported_error_code": "unsupported_capability",
  "unsupported_capabilities": ["ingestion_health", "incidents", "reports", "report_detail", "report_evidence", "trace_content", "trace_replay", "classified_workloads", "workload_readiness", "model_readiness"]
